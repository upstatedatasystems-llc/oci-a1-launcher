# ==============================================================================
# OCI Always Free A1 Launcher Configuration Template
# Place active configuration in /etc/oci-a1-launcher/launcher.env with mode 0600
# ==============================================================================

# OCI Region and Target Compartment
OCI_REGION=us-ashburn-1
COMPARTMENT_OCID=ocid1.tenancy.oc1..exampleuniquecompartmentocid

# Control Server Instance Identification
# Used for instance-principal authentication check and daily status headers
CONTROL_INSTANCE_OCID=ocid1.instance.oc1.iad.exampleuniquecontrolinstanceocid
CONTROL_INSTANCE_NAME=purgatory01-vm

# Local Timezone and Runtime Data Directory
LOCAL_TIMEZONE=America/New_York
DATA_DIR=/var/lib/oci-a1-launcher

# SMTP Email Configuration (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_FROM=your-email@gmail.com
SMTP_TO=your-email@gmail.com
SMTP_APP_PASSWORD=REPLACE_WITH_16_CHARACTER_GOOGLE_APP_PASSWORD

# Operational Timing and Safety Settings
JOB_TIMEOUT_SECONDS=1200
POLL_INTERVAL_SECONDS=20
SECOND_JOB_DELAY_SECONDS=600
INVENTORY_SETTLE_SECONDS=120
THROTTLE_COOLDOWN_SECONDS=3600
MAX_ERROR_LINES_PER_JOB=20

# Execution Mode
# Keep 'true' for initial installation testing with launcherctl doctor/run.
# Change to 'false' only after confirming IAM policies and SMTP delivery.
DRY_RUN=true
