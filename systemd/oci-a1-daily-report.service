[Unit]
Description=Email previous-day OCI A1 launcher report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/oci-a1-launcher/launcher.env
WorkingDirectory=/opt/oci-a1-launcher
ExecStart=/opt/oci-a1-launcher/venv/bin/python /opt/oci-a1-launcher/src/daily_report.py
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
